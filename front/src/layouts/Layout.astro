---
import { ClientRouter } from 'astro:transitions';
import TopBarIsland from '../components/islands/TopBarIsland.jsx';
import FloatingCartIsland from '../components/islands/FloatingCartIsland.jsx';
import Footer from '../components/Footer.jsx';
import '../styles/App.css';

const {
  title = 'Peluches Crochet',
  description = 'Tienda en línea de peluches y amigurumis tejidos a mano en crochet. Compra personajes, animales y regalos únicos con envío a todo México.',
  categorias = [],
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/iconocrochet.ico" />

    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://proyecto-e-commerce-crochet.onrender.com" />
    <ClientRouter />
  </head>
  <body>
    <div class="app-wrapper">
      <TopBarIsland client:load categorias={categorias} />
      <FloatingCartIsland client:idle />
      <slot />
      <Footer />
    </div>
  </body>
  <script>
    import '../utils/toast.js';
  </script>
</html>
