---
// Etiquetas de la PWA para el <head>: manifiesto, color de la barra e icono de iOS.
import { pwaInfo } from 'virtual:pwa-info';
---

{pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
<meta name="theme-color" content="#baa2f3" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

<script>
  import { registerSW } from 'virtual:pwa-register';
  registerSW({ immediate: true });

  // Aviso de conexión (se vuelve a pintar tras cada navegación de ClientRouter)
  function actualizarAviso() {
    let aviso = document.getElementById('aviso-offline');
    if (navigator.onLine) {
      aviso?.remove();
      return;
    }
    if (aviso) return;
    aviso = document.createElement('div');
    aviso.id = 'aviso-offline';
    aviso.setAttribute('role', 'status');
    aviso.textContent = 'Sin conexión — mostrando lo que ya habías visitado.';
    Object.assign(aviso.style, {
      position: 'fixed', left: '0', right: '0', bottom: '0', zIndex: '9999',
      padding: '10px 16px', textAlign: 'center', fontSize: '14px', fontWeight: '600',
      background: '#0f172a', color: '#fff',
    });
    document.body.appendChild(aviso);
  }

  // Le pasa al SW todas las imágenes de la página (también las lazy) para guardarlas
  function guardarImagenes() {
    if (!('serviceWorker' in navigator) || !navigator.onLine) return;
    setTimeout(async () => {
      try {
        const reg = await navigator.serviceWorker.ready;
        const urls = new Set();
        document.querySelectorAll('img').forEach((img) => {
          if (img.currentSrc) urls.add(img.currentSrc);
          if (img.src) urls.add(img.src);
        });
        reg.active?.postMessage({ type: 'CACHEAR_URLS', urls: [...urls] });
      } catch {
        /* sin SW: no pasa nada */
      }
    }, 1500); // espera a que las islas de React terminen de pintar
  }

  window.addEventListener('online', actualizarAviso);
  window.addEventListener('offline', actualizarAviso);
  document.addEventListener('astro:page-load', () => {
    actualizarAviso();
    guardarImagenes();
  });
  actualizarAviso();
  guardarImagenes();
</script>
