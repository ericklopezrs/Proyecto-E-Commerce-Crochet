---
import Layout from '../../layouts/Layout.astro';
import ProductActionsIsland from '../../components/islands/ProductActionsIsland.jsx';
import { getCategorias } from '../../lib/data';
import PrecioUSD from '../../components/PrecioUSD.jsx';
import { ArrowLeft } from 'lucide-react';
const { id } = Astro.params;
const categorias = await getCategorias();

const producto = categorias
  .flatMap((c) => c.productos ?? [])
  .find((p) => String(p.id) === String(id));

if (!producto) {
  return Astro.redirect('/');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: producto.nombre,
  description: producto.descripcion,
  image: producto.imagen,
  sku: String(producto.id),
  offers: {
    '@type': 'Offer',
    price: producto.precio,
    priceCurrency: 'MXN',
    availability:
      (producto.stock ?? 0) > 0
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
    url: `https://proyecto-e-commerce-crochet.vercel.app/producto/${producto.id}`,
  },
};
---

<Layout
  title={`${producto.nombre} — Peluches Crochet`}
  description={producto.descripcion}
  categorias={categorias}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="main-container">
    <main class="content">
      <a href="/" class="back-button" style="text-decoration: none;">
        <ArrowLeft size="1em" className="icono" style={{ marginRight: '6px' }} />
        Volver al catálogo
      </a>

      <div class="detail-container">
        <img
          src={producto.imagen || 'https://via.placeholder.com/280'}
          alt={producto.nombre}
          class="detail-image"
          width="280"
          height="280"
          fetchpriority="high"
        />

        <div class="detail-body">
          <h2 style="margin: 0 0 10px 0; font-size: 26px; color: #0f172a;">
            {producto.nombre}
          </h2>

          <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin-bottom: 16px;">
            {producto.descripcion}
          </p>

          <div class="product-stock" style="font-size: 14px; margin-bottom: 16px;">
            Stock disponible: <span>{producto.stock ?? 10} piezas</span>
          </div>

          <div class="product-price" style="font-size: 28px; margin-bottom: 20px;">
            ${producto.precio} MXN
          </div>
          <div style="color: #64748b; font-size: 14px; margin: -12px 0 20px 0;">
            <PrecioUSD client:visible mxn={producto.precio} />
          </div>

          <ProductActionsIsland client:visible producto={producto} />
        </div>
      </div>
    </main>
  </div>
</Layout>